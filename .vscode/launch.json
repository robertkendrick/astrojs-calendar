{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Astro: Server (Dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      "name": "Astro: Client (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4321",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Astro: Full-Stack (Server + Chrome)",
      "configurations": ["Astro: Server (Dev)", "Astro: Client (Chrome)"]
    }
  ]
}
